# Neon Postgres connection string. Set automatically when you connect Neon to the
# Vercel project. Leave it unset locally to use the built-in demo database.
DATABASE_URL=

# The administrator's email. It can only be registered at /register?setup=1 together with
# ADMIN_SETUP_CODE, a long random secret (at least 12 characters) that only you know.
ADMIN_EMAIL=
ADMIN_SETUP_CODE=
